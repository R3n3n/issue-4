@model IEnumerable<ITElectiveSSO.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<a asp-area="Admin"
   asp-controller="Users"
   asp-action="Create"
   class="btn btn-primary">
    Create User
</a>

<br />
<br />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Status</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>

                <td>
                    @if (user.IsActive)
                    {
                        <span class="text-success">Active</span>
                    }
                    else
                    {
                        <span class="text-danger">Inactive</span>
                    }
                </td>

                <td>
                    @user.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy")
                </td>

                <td>
                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Details"
                       asp-route-id="@user.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>